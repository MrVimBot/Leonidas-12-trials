[gd_resource type="Resource" script_class="Dialogo" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/systems/dialogo.gd" id="1_dia"]

[resource]
script = ExtResource("1_dia")
texto = "# TEXTO PROVISIONAL: sustituir por el del guion.
Zorro: Psst. Si cortas los arbustos, a veces salen monedas.
Y no vayas al bosque sin una espada: ahí fuera todo muerde."
