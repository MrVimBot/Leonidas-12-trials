[gd_resource type="Resource" script_class="Dialogo" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/systems/dialogo.gd" id="1_dia"]

[resource]
script = ExtResource("1_dia")
texto = "# PROVISIONAL (lo reescribe el guion). Zeus no deja salir del pueblo sin la misión.
Zeus: ¡Alto ahí, Leonidas!
Zeus: Aún no puedes abandonar el pueblo.
Zeus: Los sabios te esperan en el templo, en lo alto del pueblo. Escucha primero lo que tienen que decirte.
"
