[gd_resource type="Resource" script_class="Dialogo" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/systems/dialogo.gd" id="1_dia"]

[resource]
script = ExtResource("1_dia")
texto = "# PROVISIONAL. Después de que Leonidas enseñe la cabeza de piedra.
Ave: ¡La cabeza de la gorgona! Convertida en piedra...
Fauno: Lo has logrado, muchacho. Kratheon entero hablará de esto.
Toro: Guárdala tú: es tu trofeo. Pero tu prueba aún no ha terminado.
Carnero: Hay una bestia peor que Medusa: el Minotauro, mitad hombre y mitad toro.
Toro: Tu siguiente misión es derrotarlo.
Leonidas: ¿Otra vez yo?
Carnero: Vive en el corazón de un laberinto. Muchos entraron y nunca encontraron la salida.
Toro: Y hay algo más: el Minotauro es invisible. Ninguna espada puede tocar lo que no se ve.
Fauno: Dentro del laberinto, en un cofre, se esconde un cuerno.
Fauno: Búscalo antes de enfrentarte a él. Solo con ese cuerno podrás atacarlo.
Ave: Vuelve a la isla de Medusa y sigue por debajo de ella, al sur de la cueva.
Ave: El mar de allí es más bravo: rocas, corrientes y tiburones. Maniobra con cuidado.
Fauno: Que los dioses te acompañen, Leonidas.
"
