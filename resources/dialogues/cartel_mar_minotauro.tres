[resource]
script = ExtResource("1_dia")
texto = "# PROVISIONAL. Cartel de la orilla sur de la isla, al sur de la cueva de Medusa.
Cartel: Al sur, por mar: la isla del laberinto del Minotauro.
Cartel: Solo los enviados de los sabios pueden zarpar desde aquí.
"
