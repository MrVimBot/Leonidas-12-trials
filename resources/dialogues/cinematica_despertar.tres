[ext_resource type="Script" path="res://scripts/systems/dialogo.gd" id="1_dia"]

[resource]
script = ExtResource("1_dia")
texto = "# Cinemática inicial, escena 3 (cuarto): Kathita entra y Leonidas no se despierta.
# Al terminar, Leonidas se despierta de golpe (animación despertar).
Kathita: ¡Buenos días, dormilón! Espero que hayas descansado, porque hoy comienza una nueva etapa para ti.
Leonidas: ZZZZZZZZZZZZZzzzzzzz
Kathita: Leonidas, despierta.
Leonidas: zzzzzzzzzzzzzzzzz
Kathita: Leonidas...
Leonidas: ZZZZZZZZZZZZzzzZZZZZZZZZ
Kathita: ¡¡¡LEONIDAS!!!
"
