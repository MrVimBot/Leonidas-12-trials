[ext_resource type="Script" path="res://scripts/systems/dialogo.gd" id="1_dia"]

[resource]
script = ExtResource("1_dia")
texto = "# TEXTO PROVISIONAL: cuando no llegas al precio más barato.
Tendera: ¡Hola, Leonidas! Tengo manzanas frescas del bosque.
Vuelve cuando tengas monedas y te vendo alguna."
