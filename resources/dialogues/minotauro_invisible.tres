[ext_resource type="Script" path="res://scripts/systems/dialogo.gd" id="1_dia"]

[resource]
script = ExtResource("1_dia")
texto = "# PROVISIONAL. El Minotauro se vuelve invisible (Leonidas aún no tiene el cuerno).
Leonidas: ¡Ha desaparecido! Los sabios tenían razón: es invisible.
Leonidas: Tengo que encontrar el cofre del cuerno antes de que él me encuentre a mí.
"
