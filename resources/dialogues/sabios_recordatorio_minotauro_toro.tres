[ext_resource type="Script" path="res://scripts/systems/dialogo.gd" id="1_dia"]

[resource]
script = ExtResource("1_dia")
texto = "# PROVISIONAL. Con la misión del Minotauro.
Toro: El Minotauro no tendrá piedad. Tú tampoco la tengas.
Toro: Y recuerda: sin el cuerno es invencible. No te enfrentes a él con las manos vacías.
"
