[ext_resource type="Script" path="res://scripts/systems/dialogo.gd" id="1_dia"]

[resource]
script = ExtResource("1_dia")
texto = "# PROVISIONAL. Si se vuelve a hablar con Medusa después del trato.
Medusa: Gracias por tu piedad, Leonidas.
Medusa: Recuerda: para el mundo, Medusa ha muerto.
"
