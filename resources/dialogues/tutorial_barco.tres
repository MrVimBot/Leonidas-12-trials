[gd_resource type="Resource" script_class="Dialogo" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/systems/dialogo.gd" id="1_dia"]

[resource]
script = ExtResource("1_dia")
texto = "# TEXTO PROVISIONAL: sustituir por el del guion.
Leonidas: ¡A navegar!
Elijo el rumbo con las teclas de moverme.
Si soplo al micrófono, la vela se hincha y voy más rápido.
Sin micrófono: mantener Espacio.
Cuidado con rocas, remolinos y tiburones.
(Guarda silencio un momento...)"
