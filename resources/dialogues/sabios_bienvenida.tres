[gd_resource type="Resource" script_class="Dialogo" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/systems/dialogo.gd" id="1_dia"]

[resource]
script = ExtResource("1_dia")
texto = "# PROVISIONAL (lo reescribe el guion). Al llegar Leonidas ante el templo.
Toro: Bienvenido, Leonidas, hijo de Kathita. Te esperábamos.
Carnero: Ayer cumpliste quince años. Ya conoces la tradición: todo joven de Kratheon recibe una misión de los sabios.
Fauno: Si la cumples, serás tenido por adulto y ciudadano de nuestra gran nación.
Leonidas: Sí, sí... la carta lo explicaba. ¿Y cuál es la mía?
"
