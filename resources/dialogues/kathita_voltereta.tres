[resource]
script = ExtResource("1_dia")
texto = "# PROVISIONAL (lo reescribe el guion). Tutorial de la voltereta.
Kathita: Una cosa más. Cuando algo te persiga, no te quedes quieto: ¡rueda!
Kathita: Pulsa Espacio (o K; A en el mando) para dar una voltereta. Cansa: mira la barra de estamina.
Kathita: ¡Inténtalo!
"
