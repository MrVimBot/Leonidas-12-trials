[gd_resource type="Resource" script_class="Dialogo" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/systems/dialogo.gd" id="1_dia"]

[resource]
script = ExtResource("1_dia")
texto = "# PROVISIONAL. El Minotauro, vencido, antes de que Leonidas se lleve su cuerno.
Minotauro: Grrr... Me has vencido, pequeño humano.
Minotauro: ¡Espera! No me mates, te lo suplico.
Leonidas: Tranquilo. No voy a matarte.
Leonidas: Pero necesito tu cuerno: los sabios esperan una prueba de mi victoria.
Minotauro: Llévatelo... y déjame en paz en mi laberinto.
"
