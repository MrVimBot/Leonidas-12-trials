[gd_resource type="Resource" script_class="Dialogo" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/systems/dialogo.gd" id="1_dia"]

[resource]
script = ExtResource("1_dia")
texto = "# PROVISIONAL. Después del primer espadazo.
Toro: Nada mal. Con ella podrás abrirte paso por el bosque.
Fauno: Recuerda: al sur, hasta la orilla. Que los dioses te acompañen, Leonidas.
Toro: Y vuelve con la cabeza de Medusa. Te estaremos esperando.
"
