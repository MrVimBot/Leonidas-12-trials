[gd_resource type="Resource" script_class="Dialogo" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/systems/dialogo.gd" id="1_dia"]

[resource]
script = ExtResource("1_dia")
texto = "# PROVISIONAL. Si se vuelve a hablar con este sabio.
Ave: Cuando estés ante Medusa, no la mires a los ojos.
Ave: Muchos valientes acabaron convertidos en piedra por olvidarlo.
"
