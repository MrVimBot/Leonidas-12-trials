[ext_resource type="Script" path="res://scripts/systems/dialogo.gd" id="1_dia"]

[resource]
script = ExtResource("1_dia")
texto = "# PROVISIONAL. Si Leonidas se aleja de los sabios antes de probar la espada.
Toro: ¡Eh, no tan deprisa, muchacho!
Toro: Antes de irte, prueba la espada. Golpea el aire con [J].
"
