[gd_resource type="Resource" script_class="Dialogo" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/systems/dialogo.gd" id="1_dia"]

[resource]
script = ExtResource("1_dia")
texto = "# PROVISIONAL. Leonidas aún no tiene el cuerno: el Minotauro no recibe daño.
Leonidas: Los sabios tenían razón: sin el cuerno, nada podrá herirlo.
Leonidas: Tengo que encontrar el cofre antes de que me alcance.
"
