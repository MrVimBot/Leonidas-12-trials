[gd_resource type="Resource" script_class="Dialogo" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/systems/dialogo.gd" id="1_dia"]

[resource]
script = ExtResource("1_dia")
texto = "# PROVISIONAL. Se apagan las luces y el Minotauro aparece en el centro del laberinto.
Minotauro: ¡GRAAAH! ¿Quién se atreve a entrar en mi laberinto?
Minotauro: Nadie sale de aquí con vida.
"
