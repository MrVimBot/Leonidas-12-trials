; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Las casi 12 pruebas de Leonidas"
run/main_scene="res://scenes/ui/menu_principal.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Leonidas-12-pruebas"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://d37dva6cy1x8n"
driver/enable_input=true

[autoload]

EstadoJuego="*res://autoload/estado_juego.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
SonidosUI="*res://scenes/ui/sonidos_ui.tscn"
Entrada="*res://autoload/esquema_entrada.gd"
ControllerIcons="*uid://ba0u08kqujbda"
Dialogos="*res://scenes/ui/caja_dialogo.tscn"
Tienda="*res://scenes/ui/menu_tienda.tscn"
Microfono="*res://autoload/microfono.gd"
Libro="*res://scenes/ui/menu_libro.tscn"
Musica="*res://autoload/musica.gd"
Daltonismo="*res://scenes/ui/filtro_daltonismo.tscn"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/AsepriteWizard/plugin.cfg", "res://addons/controller_icons/plugin.cfg", "res://addons/godot-eyesee/plugin.cfg", "res://addons/godot_ai/plugin.cfg")

[gui]

theme/custom="res://resources/ui/tema.tres"

