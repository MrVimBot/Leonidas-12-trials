[layer_names]

2d_physics/layer_1="mundo"
2d_physics/layer_2="jugador"
2d_physics/layer_3="enemigos"
2d_physics/layer_4="golpe_jugador"
2d_physics/layer_5="golpe_enemigo"
2d_physics/layer_6="interactuable"
2d_physics/layer_7="obstaculo_bajo"

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
